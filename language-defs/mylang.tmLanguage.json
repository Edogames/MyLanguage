{
	"scopeName": "source.mylang",
	"patterns": [
		{
			"name": "comment.line.double-slash",
			"match": "//.*$"
		},
		{
			"name": "comment.block",
			"begin": "/\\*",
			"end": "\\*/"
		},
		{
			"name": "keyword.control",
			"match": "\\b(if|else|while|for|return)\\b"
		},
		{
			"name": "keyword.other",
			"match": "\\b(void|string|from|import|clear_console)\\b"
		},
		{
			"name": "entity.name.function",
			"match": "\\b(print|input|strcmp|string_has|sayhi|saybye|shit)\\b"
		},
		{
			"name": "string.quoted.double",
			"match": "\"[^\"]*\""
		},
		{
			"name": "string.interpolated",
			"begin": "\\$\"",
			"end": "\"",
			"patterns": [
				{
					"name": "variable.other",
					"match": "\\{[^}]*\\}"
				}
			]
		},
		{
			"name": "constant.numeric",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},
		{
			"name": "variable.other",
			"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
		}
	]
}